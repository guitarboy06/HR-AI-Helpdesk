  METHOD create_emp_data.
    lt_dept = VALUE #( ( dept =  'IT' )
                       ( dept = 'HR' )
                       ( dept =  'Finance' )
                       ( dept = 'Payroll' ) ).

    lt_desig = VALUE #( ( desig = 'Developer' )
                        ( desig = 'Consultant' )
                        ( desig = 'Manager' )
                        ( desig = 'Senior Developer' ) ).
    DO 20 TIMES.
      ls_employee-employee_id = cl_abap_random_int=>create(
                                          seed = cl_abap_random=>seed( )
                                          min  = 100
                                          max  = 999 )->get_next( ) .
      ls_employee-employee_name = | E_{ sy-index } |.
      ls_employee-department = lt_dept[ cl_abap_random_int=>create(
                                 seed = cl_abap_random=>seed( )
                                 min  = 1
                                 max  = lines( lt_dept )
                               )->get_next( ) ]-dept.
      ls_employee-designation = lt_desig[ cl_abap_random_int=>create(
                                  seed = cl_abap_random=>seed( )
                                  min  = 1
                                  max  = lines( lt_desig )
                                )->get_next( ) ]-desig.
      ls_employee-basic_salary = cl_abap_random_int=>create(
                                  seed = cl_abap_random=>seed( )
                                  min  = 50000
                                  max  = 200000
                                )->get_next( ).
      ls_employee-joining_date = '20200101' + cl_abap_random_int=>create(
                                  seed = cl_abap_random=>seed( )
                                  min  = 1
                                  max  = 720
                                )->get_next( ).

      ls_employee-currency = 'INR'.
      ls_employee-created_by = sy-uname.
      ls_employee-created_on = lv_timestamp.
      ls_employee-last_changed_by = sy-uname.
      ls_employee-last_changed_at = lv_timestamp.

      APPEND ls_employee TO lt_employee.

      CLEAR: ls_employee.
    ENDDO.

    MODIFY zai_employee FROM TABLE @lt_employee.

    IF sy-subrc = 0.
      out->write( 'Employee Master records created ' ).
    ELSE.
      out->write( 'Employee can not be inserted' ).
    ENDIF.
  ENDMETHOD.

  METHOD create_payroll_data.
    SELECT
      FROM zai_employee
      FIELDS employee_id, basic_salary
      INTO TABLE @lt_employee_salary.

    LOOP AT lt_employee_salary INTO ls_employee_salary.
      DO 6 TIMES.
        ls_payroll-employee_id = ls_employee_salary-employee_id.
        CASE sy-index.
          WHEN 1.
            ls_payroll-payroll_month = '2026-01'.
          WHEN 2.
            ls_payroll-payroll_month = '2026-02'.
          WHEN 3.
            ls_payroll-payroll_month = '2026-03'.
          WHEN 4.
            ls_payroll-payroll_month = '2026-04'.
          WHEN 5.
            ls_payroll-payroll_month = '2026-05'.
          WHEN 6.
            ls_payroll-payroll_month = '2026-06'.
        ENDCASE.
        TRY.
            ls_payroll-payroll_id = cl_system_uuid=>create_uuid_x16_static( ).
          CATCH cx_uuid_error INTO cx_error.
        ENDTRY.
        ls_payroll-basic_salary = ls_employee_salary-basic_salary.
        ls_payroll-allowance = ls_payroll-basic_salary * '0.10'.
        ls_payroll-gross_salary = ls_payroll-basic_salary + ls_payroll-allowance.
        ls_payroll-tax = ls_payroll-gross_salary * '0.10'.
        ls_payroll-pf = ls_payroll-basic_salary * '0.12'.
        ls_payroll-lop_deduction = 0.
        ls_payroll-other_deduction = 0.
        ls_payroll-total_deduction = ls_payroll-tax + ls_payroll-pf + ls_payroll-lop_deduction + ls_payroll-other_deduction.
        ls_payroll-net_salary = ls_payroll-gross_salary - ls_payroll-total_deduction.

        ls_payroll-created_by = sy-uname.
        ls_payroll-created_on = lv_timestamp.
        ls_payroll-last_changed_by = sy-uname.
        ls_payroll-last_changed_at = lv_timestamp.

        APPEND ls_payroll TO lt_payroll.
        CLEAR: ls_payroll.
      ENDDO.
    ENDLOOP.

    MODIFY zai_payroll FROM TABLE @lt_payroll.
    out->write(
      |Payroll records created: { lines( lt_payroll ) }|
    ).

  ENDMETHOD.

