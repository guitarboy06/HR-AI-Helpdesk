  METHOD modify_entries.

    "Attendance Modification
    SELECT FROM zai_i_employee
    FIELDS EmployeeId,
           BasicSalary
    INTO TABLE @DATA(lt_employee).
    DATA(lv_year) = '2026'.

    LOOP AT lt_employee INTO DATA(ls_employee).
      DO 6 TIMES.
        DATA(lv_month) = |{ lv_year }-0{ sy-index }|.
        DATA(lv_present_days) = cl_abap_random_int=>create(
                                                      seed = cl_abap_random=>seed( )
                                                      min  = 15
                                                      max  = 22 )->get_next( ).
        TRY.
            APPEND VALUE #(
               client = sy-mandt
               attendance_id =
                 cl_system_uuid=>create_uuid_x16_static( )
               employee_id = ls_employee-EmployeeId
               attendance_month = lv_month
               working_days = 22
               present_days = lv_present_days
               absent_days = 22 - lv_present_days
               lop_days = 22 - lv_present_days
               overtime_hours = '0'
               created_by = sy-uname
               created_on = lv_timestamp
               last_changed_by = sy-uname
               last_changed_at = lv_timestamp
             ) TO lt_attendance.
          CATCH cx_uuid_error INTO cx_error.
        ENDTRY.
      ENDDO.

    ENDLOOP.

    MODIFY zai_attendance FROM TABLE @lt_attendance.
    IF sy-subrc = 0.
      out->write(
        |Attendance records created: { lines( lt_attendance ) }|
      ).

      "Leave Modification
      SELECT FROM zai_i_attendance
      FIELDS *
      INTO TABLE @DATA(lt_attend).

      LOOP AT lt_attend INTO DATA(ls_attend).
        TRY.
            APPEND VALUE #(
               client = sy-mandt
               leave_id = cl_system_uuid=>create_uuid_x16_static( )
               employee_id = ls_attend-EmployeeId
               leave_month = ls_attend-AttendanceMonth
               leave_type = 'Priviledged Leave'
               total_days = ls_attend-AbsentDays
               lop_days = ls_attend-LopDays
               created_by = sy-uname
               created_on = lv_timestamp
               last_changed_by = sy-uname
               last_changed_at = lv_timestamp
             ) TO lt_leave.
          CATCH cx_uuid_error INTO cx_error.
        ENDTRY.
      ENDLOOP.
      MODIFY zai_leave FROM TABLE @lt_leave.
      IF sy-subrc = 0.
        out->write(
          |Leave records created: { lines( lt_leave ) }|
        ).

        "Payroll Modification
        SELECT FROM zai_payroll AS p
        INNER JOIN zai_employee AS e ON ( p~employee_id = e~employee_id AND p~basic_salary <> e~basic_salary )
        FIELDS p~*
        INTO TABLE @DATA(lt_modif_pay).

        DELETE zai_payroll FROM TABLE @lt_modif_pay.

        SELECT FROM zai_payroll
        FIELDS *
        INTO TABLE @DATA(lt_pay).

        LOOP AT lt_pay ASSIGNING FIELD-SYMBOL(<fs_pay>).
          DATA(lv_lop_days) = lt_leave[ employee_id = <fs_pay>-employee_id
                                        leave_month = <fs_pay>-payroll_month ]-lop_days.
          <fs_pay>-lop_deduction = <fs_pay>-basic_salary / 22 * lv_lop_days.
          <fs_pay>-total_deduction = <fs_pay>-tax + <fs_pay>-pf + <fs_pay>-lop_deduction + <fs_pay>-other_deduction.
          <fs_pay>-net_salary = <fs_pay>-gross_salary - <fs_pay>-total_deduction.

          <fs_pay>-created_by = sy-uname.
          <fs_pay>-created_on = lv_timestamp.
          <fs_pay>-last_changed_by = sy-uname.
          <fs_pay>-last_changed_at = lv_timestamp.
        ENDLOOP.

        MODIFY zai_payroll FROM TABLE @lt_pay.
        out->write(
          |Payroll records created: { lines( lt_pay ) }|
        ).

      ENDIF.
    ENDIF.
  ENDMETHOD.

